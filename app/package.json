{
  "name": "app",
  "version": "0.0.1",
  "description": "AMLIG clinic desktop app",
  "private": true,
  "main": "out/main/index.cjs",
  "scripts": {
    "postinstall": "install-electron",
    "dev": "electron-vite dev",
    "dev:renderer": "vite --config renderer.vite.config.mts",
    "test:e2e": "playwright test",
    "test:integration": "pnpm build && node scripts/verify-integration.mts",
    "preview": "electron-vite preview",
    "build": "electron-vite build",
    "package:windows": "pnpm build && node scripts/package-windows.mts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@radix-ui/react-slot": "1.5.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "motion": "14.2.0",
    "pdfjs-dist": "^6.4.299",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sonner": "2.0.3",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "@playwright/test": "1.62.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "44.7.2",
    "electron-vite": "5.0.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "5.0.4"
  }
}
