# Main-process development connection only; no credentials or renderer VITE_* secrets.
HEALTH_IER_SERVER_URL=http://127.0.0.1:3000
HEALTH_IER_ALLOW_SYNTHETIC_HTTP=true
# Later, for a trusted clinic HTTPS origin (including packaged clients):
# HEALTH_IER_SERVER_URL=https://clinic.example:3000
# HEALTH_IER_ALLOW_SYNTHETIC_HTTP=false
# Packaged clients reject HTTP even if the flag is true. Normal TLS validation stays enabled.
