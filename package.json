{
  "name": "health-ier",
  "version": "0.0.1",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/aandremillan10/health-ier.git"
  },
  "packageManager": "pnpm@10.30.1",
  "engines": {
    "node": ">=24.13.0 <25"
  },
  "scripts": {
    "prepare": "husky",
    "dev:app": "pnpm --filter app dev",
    "dev:server": "pnpm --filter server start:dev",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter server test:e2e",
    "build": "pnpm -r build",
    "build:server": "pnpm --filter server build",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test && pnpm test:e2e && pnpm build:server"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.0.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "16.0.0",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "prettier": "3.9.10",
    "typescript-eslint": "^8.20.0"
  }
}
