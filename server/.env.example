# Host API connected to compose.dev.yaml; synthetic development only.
NODE_ENV=development
PORT=3000
SERVER_MODE=EDGE
CLINIC_ID=synthetic-clinic
DATABASE_URL=postgresql://healthier_dev:healthier_dev_only@127.0.0.1:5432/healthier_demo_dev
DEMO_CREDENTIALS_FILE=../.private/demo-credentials.json
# Teammate local development does not send records to the real cloud demo.
MIRROR_ENABLED=false
MIRROR_URL=
MIRROR_MACHINE_TOKEN=
# For an authorized mirror, set a verified HTTPS /internal/mirror/events URL
# and a private clinic-scoped machine token; never put them in app/.env.
